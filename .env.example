# ============================================
# DATABASE CONFIGURATION - ENVIRONMENT VARIABLES
# ============================================
# This file contains all possible configuration options for the database module.
# Copy this file to .env and adjust values as needed.
# For production, use only necessary variables. For development, you can enable all.

# ======================
# MODULE ENABLED/DISABLED
# ======================
# Enable or disable the entire database module
# Values: true | false
DB_ENABLED=true

# ======================
# CROSS-DATABASE QUERIES
# ======================
# Enable cross-database queries (if supported by your database)
# Values: true | false
DB_CROSS_DB=false

# ======================
# DEFAULT CONNECTION
# ======================
# Default database connection to use
# Values: primary | mysql | postgres | sqlite | mongodb | redis | mssql | oracle
DB_DEFAULT_CONNECTION=primary

# ======================
# DATABASE DRIVER MODULES
# ======================
# Enable/disable specific database drivers
# Each driver can be independently enabled or disabled

# MySQL/MariaDB driver
DB_DRIVER_MYSQL_ENABLED=true

# PostgreSQL driver
DB_DRIVER_POSTGRES_ENABLED=false

# SQLite driver
DB_DRIVER_SQLITE_ENABLED=false

# MongoDB driver
DB_DRIVER_MONGODB_ENABLED=false

# Redis driver
DB_DRIVER_REDIS_ENABLED=false

# Microsoft SQL Server driver
DB_DRIVER_MSSQL_ENABLED=false

# Oracle Database driver
DB_DRIVER_ORACLE_ENABLED=false

# ======================
# EXTERNAL DRIVERS
# ======================
# Enable external/custom database drivers
DB_EXTERNAL_DRIVERS_ENABLED=false
DB_EXTERNAL_DRIVERS_PATH=./external-drivers

# ======================
# CACHE CONFIGURATION
# ======================
# Query cache settings
DB_CACHE_ENABLED=false
DB_CACHE_TTL=300000
DB_CACHE_MAX_SIZE=1000
DB_CACHE_STRATEGY=lru

# ======================
# CONNECTION POOL
# ======================
# Database connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_ACQUIRE_TIMEOUT=10000
DB_POOL_EVICTION_RUN_INTERVAL=60000

# ======================
# RETRY CONFIGURATION
# ======================
# Query retry settings for failed connections
DB_RETRY_MAX_ATTEMPTS=3
DB_RETRY_DELAY=1000
DB_RETRY_BACKOFF=true

# ======================
# MYSQL CONNECTION
# ======================
# MySQL/MariaDB connection settings (only if DB_DRIVER_MYSQL_ENABLED=true)
DB_DRIVER_MYSQL_HOST=localhost
DB_DRIVER_MYSQL_PORT=3306
DB_DRIVER_MYSQL_USER=root
DB_DRIVER_MYSQL_PASSWORD=your_mysql_password
DB_DRIVER_MYSQL_DATABASE=mydb
DB_DRIVER_MYSQL_CHARSET=utf8mb4
DB_DRIVER_MYSQL_TIMEZONE=+00:00

# ======================
# POSTGRESQL CONNECTION
# ======================
# PostgreSQL connection settings (only if DB_DRIVER_POSTGRES_ENABLED=true)
DB_DRIVER_POSTGRES_HOST=localhost
DB_DRIVER_POSTGRES_PORT=5432
DB_DRIVER_POSTGRES_USER=postgres
DB_DRIVER_POSTGRES_PASSWORD=your_postgres_password
DB_DRIVER_POSTGRES_DATABASE=mydb
DB_DRIVER_POSTGRES_SSL=false

# ======================
# SQLITE CONNECTION
# ======================
# SQLite connection settings (only if DB_DRIVER_SQLITE_ENABLED=true)
DB_DRIVER_SQLITE_DATABASE=:memory:
DB_DRIVER_SQLITE_MODE=memory

# ======================
# MONGODB CONNECTION
# ======================
# MongoDB connection settings (only if DB_DRIVER_MONGODB_ENABLED=true)
DB_DRIVER_MONGODB_HOST=localhost
DB_DRIVER_MONGODB_PORT=27017
DB_DRIVER_MONGODB_USER=admin
DB_DRIVER_MONGODB_PASSWORD=your_mongodb_password
DB_DRIVER_MONGODB_DATABASE=mydb
DB_DRIVER_MONGODB_AUTH_SOURCE=admin

# ======================
# REDIS CONNECTION
# ======================
# Redis connection settings (only if DB_DRIVER_REDIS_ENABLED=true)
DB_DRIVER_REDIS_HOST=localhost
DB_DRIVER_REDIS_PORT=6379
DB_DRIVER_REDIS_PASSWORD=your_redis_password
DB_DRIVER_REDIS_DB=0
DB_DRIVER_REDIS_KEY_PREFIX=

# ======================
# MSSQL CONNECTION
# ======================
# Microsoft SQL Server connection settings (only if DB_DRIVER_MSSQL_ENABLED=true)
DB_DRIVER_MSSQL_HOST=localhost
DB_DRIVER_MSSQL_PORT=1433
DB_DRIVER_MSSQL_USER=sa
DB_DRIVER_MSSQL_PASSWORD=your_mssql_password
DB_DRIVER_MSSQL_DATABASE=mydb
DB_DRIVER_MSSQL_ENCRYPT=false
DB_DRIVER_MSSQL_TRUST_SERVER_CERTIFICATE=false

# ======================
# ORACLE CONNECTION
# ======================
# Oracle Database connection settings (only if DB_DRIVER_ORACLE_ENABLED=true)
DB_DRIVER_ORACLE_HOST=localhost
DB_DRIVER_ORACLE_PORT=1521
DB_DRIVER_ORACLE_USER=system
DB_DRIVER_ORACLE_PASSWORD=your_oracle_password
DB_DRIVER_ORACLE_SERVICE_NAME=ORCL
DB_DRIVER_ORACLE_CONNECT_STRING=

# ======================
# MIDDLEWARE CONFIGURATION
# ======================

# Query Logger Middleware
DB_MIDDLEWARE_QUERY_LOGGER_ENABLED=true
DB_MIDDLEWARE_QUERY_LOGGER_LOG_LEVEL=info
DB_MIDDLEWARE_QUERY_LOGGER_SLOW_QUERY_THRESHOLD=1000
DB_MIDDLEWARE_QUERY_LOGGER_LOG_TO_CONSOLE=true
DB_MIDDLEWARE_QUERY_LOGGER_LOG_TO_FILE=false
DB_MIDDLEWARE_QUERY_LOGGER_LOG_FILE=query.log

# Connection Pool Middleware
DB_MIDDLEWARE_CONNECTION_POOL_ENABLED=true
DB_MIDDLEWARE_CONNECTION_POOL_MAX_CONNECTIONS=10
DB_MIDDLEWARE_CONNECTION_POOL_MIN_CONNECTIONS=2
DB_MIDDLEWARE_CONNECTION_POOL_IDLE_TIMEOUT=30000
DB_MIDDLEWARE_CONNECTION_POOL_ACQUIRE_TIMEOUT=10000
DB_MIDDLEWARE_CONNECTION_POOL_EVICTION_RUN_INTERVAL=60000
DB_MIDDLEWARE_CONNECTION_POOL_TEST_ON_BORROW=true
DB_MIDDLEWARE_CONNECTION_POOL_TEST_ON_RETURN=true

# Query Cache Middleware
DB_MIDDLEWARE_QUERY_CACHE_ENABLED=false
DB_MIDDLEWARE_QUERY_CACHE_TTL=300000
DB_MIDDLEWARE_QUERY_CACHE_MAX_SIZE=1000
DB_MIDDLEWARE_QUERY_CACHE_STRATEGY=lru
DB_MIDDLEWARE_QUERY_CACHE_CACHE_NULL_RESULTS=true
DB_MIDDLEWARE_QUERY_CACHE_CACHE_ERRORS=false

# Performance Monitor Middleware
DB_MIDDLEWARE_PERFORMANCE_MONITOR_ENABLED=true
DB_MIDDLEWARE_PERFORMANCE_MONITOR_SLOW_QUERY_THRESHOLD=1000
DB_MIDDLEWARE_PERFORMANCE_MONITOR_MAX_QUERY_HISTORY=1000
DB_MIDDLEWARE_PERFORMANCE_MONITOR_COLLECT_METRICS=true
DB_MIDDLEWARE_PERFORMANCE_MONITOR_METRICS_INTERVAL=60000
DB_MIDDLEWARE_PERFORMANCE_MONITOR_ALERT_THRESHOLD_SLOW_QUERIES_PER_MINUTE=10
DB_MIDDLEWARE_PERFORMANCE_MONITOR_ALERT_THRESHOLD_ERROR_RATE=0.1
DB_MIDDLEWARE_PERFORMANCE_MONITOR_ALERT_THRESHOLD_CONNECTION_ERRORS=5

# ======================
# MIGRATION CONFIGURATION
# ======================
DB_MIGRATIONS_TABLE=migrations
DB_MIGRATIONS_PATH=./migrations
DB_MIGRATIONS_USE_TRANSACTIONS=true
